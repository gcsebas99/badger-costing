  "components": {
    "schemas": {
      "CostMode": {
        "type": "string",
        "enum": [
          "average_last_3",
          "latest"
        ],
        "title": "CostMode"
      },
      "EquivalenceIn": {
        "properties": {
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          }
        },
        "type": "object",
        "required": [
          "quantity",
          "unit"
        ],
        "title": "EquivalenceIn",
        "description": "1 pz = quantity unit (unit must be mass or volume)."
      },
      "EquivalenceRead": {
        "properties": {
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          }
        },
        "type": "object",
        "required": [
          "quantity",
          "unit"
        ],
        "title": "EquivalenceRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database"
        ],
        "title": "HealthRead"
      },
      "PriceCreate": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "purchased_on": {
            "type": "string",
            "format": "date",
            "title": "Purchased On"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "PriceCreate"
      },
      "PriceRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          },
          "purchased_on": {
            "type": "string",
            "format": "date",
            "title": "Purchased On"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "in_effect": {
            "type": "boolean",
            "title": "In Effect",
            "description": "Whether this price is part of the current cost."
          }
        },
        "type": "object",
        "required": [
          "id",
          "amount",
          "supplier",
          "purchased_on",
          "created_at",
          "in_effect"
        ],
        "title": "PriceRead"
      },
      "SettingsRead": {
        "properties": {
          "cost_mode": {
            "$ref": "#/components/schemas/CostMode"
          }
        },
        "type": "object",
        "required": [
          "cost_mode"
        ],
        "title": "SettingsRead"
      },
      "SettingsUpdate": {
        "properties": {
          "cost_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CostMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "SettingsUpdate"
      },
      "SupplyCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "group": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Group"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          },
          "pack_qty": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Pack Qty"
          },
          "pack_unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "equivalence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquivalenceIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "initial_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriceCreate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "group",
          "pack_qty",
          "pack_unit"
        ],
        "title": "SupplyCreate"
      },
      "SupplyDetail": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "group": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Group"
          },
          "supplier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier"
          },
          "pack_qty": {
            "type": "string",
            "title": "Pack Qty"
          },
          "pack_unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "equivalence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquivalenceRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "base_unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "current_price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Price",
            "description": "Current ₡ per pack."
          },
          "unit_cost": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Cost",
            "description": "₡ per base unit (g, ml or pz)."
          },
          "reference_unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "reference_unit_cost": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Unit Cost",
            "description": "₡ per kg, L or pz."
          },
          "last_price_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Price Date"
          },
          "price_count": {
            "type": "integer",
            "title": "Price Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PriceRead"
            },
            "type": "array",
            "title": "Prices"
          }
        },
        "type": "object",
        "required": [
          "name",
          "group",
          "pack_qty",
          "pack_unit",
          "id",
          "equivalence",
          "base_unit",
          "current_price",
          "unit_cost",
          "reference_unit",
          "reference_unit_cost",
          "last_price_date",
          "price_count",
          "created_at",
          "updated_at",
          "prices"
        ],
        "title": "SupplyDetail"
      },
